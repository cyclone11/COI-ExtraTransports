<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ExtraTransports</AssemblyName>
    <RootNamespace>ExtraTransports</RootNamespace>
    <Version>0.0.6</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- 支持直接指定 Managed 目录，也兼容官方示例使用的 COI_ROOT。 -->
    <CaptainIndustryManagedPath Condition="'$(CaptainIndustryManagedPath)' == '' and '$(CAPTAIN_INDUSTRY_MANAGED_PATH)' != ''">$(CAPTAIN_INDUSTRY_MANAGED_PATH)</CaptainIndustryManagedPath>
    <CaptainIndustryManagedPath Condition="'$(CaptainIndustryManagedPath)' == '' and '$(COI_ROOT)' != ''">$(COI_ROOT)\Captain of Industry_Data\Managed</CaptainIndustryManagedPath>
    <CaptainIndustryManagedPath Condition="'$(CaptainIndustryManagedPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Captain of Industry\Captain of Industry_Data\Managed</CaptainIndustryManagedPath>
    <!-- 输出目录与 manifest.id 一致，编译结果可直接复制到 Mods。 -->
    <OutputPath>bin\$(Configuration)\ExtraTransports\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.png;Assets\Textures\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 游戏程序集由已安装的游戏提供，编译时不复制到模组目录。 -->
    <Reference Include="Mafi">
      <HintPath>$(CaptainIndustryManagedPath)\Mafi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Base">
      <HintPath>$(CaptainIndustryManagedPath)\Mafi.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Core">
      <HintPath>$(CaptainIndustryManagedPath)\Mafi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Unity">
      <HintPath>$(CaptainIndustryManagedPath)\Mafi.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(CaptainIndustryManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(CaptainIndustryManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(CaptainIndustryManagedPath)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json;LICENSE;README.md;thumbnail.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Translations\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(CaptainIndustryManagedPath)\Mafi.dll')"
           Text="找不到 Mafi.dll。请将 CAPTAIN_INDUSTRY_MANAGED_PATH 指向游戏的 Captain of Industry_Data\Managed 目录，或设置 COI_ROOT。" />
    <Error Condition="!Exists('$(CaptainIndustryManagedPath)\Mafi.Base.dll') Or !Exists('$(CaptainIndustryManagedPath)\Mafi.Core.dll')"
           Text="游戏程序集不完整。请从同一游戏构建提供 Mafi.dll、Mafi.Base.dll 和 Mafi.Core.dll。" />
    <GetAssemblyIdentity AssemblyFiles="$(CaptainIndustryManagedPath)\Mafi.dll">
      <Output TaskParameter="Assemblies" ItemName="_GameAssembly" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <_ExtraTransportsGameVersion>@(_GameAssembly->'%(Version)')</_ExtraTransportsGameVersion>
    </PropertyGroup>
    <Error Condition="$([MSBuild]::VersionLessThan('$(_ExtraTransportsGameVersion)', '0.8.8.0'))"
           Text="此源码修订面向 0.8.8 或更新版本，请使用对应游戏构建的 Managed 目录。" />
  </Target>

</Project>
